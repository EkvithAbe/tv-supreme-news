generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

/**
 * =========================================================
 * ENUMS
 * =========================================================
 */

enum UserRole {
  ADMIN
  EDITOR
}

enum ArticleStatus {
  DRAFT
  REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum Language {
  EN
  SI
  TA
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

enum HomepageSectionType {
  HERO
  FEATURED
  LATEST
  TRENDING
  TOP_STORIES
  VIDEOS
  PROMO
}

enum VideoStatus {
  DRAFT
  REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum LiveStreamType {
  HLS
  MP4
  EMBED
  OTHER
}

enum ProfileChangeRequestType {
  EMAIL
  PASSWORD
}

enum ProfileChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/* =========================================================
   USER
========================================================= */

model User {
  id             String     @id @default(cuid())
  name           String
  email          String     @unique
  passwordHash   String
  role           UserRole   @default(EDITOR)

  phone          String?
  jobTitle       String?
  bio            String?    @db.Text
  profileImageId String?

  articles       Article[]
  sessions       Session[]
  profileImage   Media?     @relation("UserProfileImage", fields: [profileImageId], references: [id], onDelete: SetNull)
  activityLogs   ActivityLog[]
  notifications  Notification[]
  changeRequests ProfileChangeRequest[] @relation("ProfileChangeRequestUser")
  reviewedProfileChangeRequests ProfileChangeRequest[] @relation("ProfileChangeRequestReviewer")

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

/* =========================================================
   AUTHENTICATION SESSIONS
========================================================= */

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.Char(64)
  userId    String
  expiresAt DateTime

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

/**
 * =========================================================
 * NEWS CATEGORY
 * =========================================================
 */

model Category {
  id   String @id @default(cuid())
  slug String @unique

  translations CategoryTranslation[]
  articles     Article[]

  /**
   * Existing relationship.
   * Kept unchanged.
   */
  videos Video[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  language    Language
  name        String
  description String?   @db.Text

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, language])
}

/**
 * =========================================================
 * VIDEO CATEGORY
 * =========================================================
 */

model VideoCategory {
  id   String @id @default(cuid())
  slug String @unique

  translations VideoCategoryTranslation[]
  videos       Video[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VideoCategoryTranslation {
  id              String   @id @default(cuid())
  videoCategoryId String
  language        Language
  name            String
  description     String?  @db.Text

  videoCategory VideoCategory @relation(fields: [videoCategoryId], references: [id], onDelete: Cascade)

  @@unique([videoCategoryId, language])
}

/**
 * =========================================================
 * ARTICLE
 * =========================================================
 */

model Article {
  id   String @id @default(cuid())
  slug String @unique

  status ArticleStatus @default(DRAFT)

  categoryId  String
  authorId    String
  mainImageId String?

  isBreaking     Boolean @default(false)
  isFeatured     Boolean @default(false)
  showOnHomepage Boolean @default(false)
  showInLatest   Boolean @default(true)

  views Int @default(0)

  publishedAt DateTime?
  scheduledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category  Category @relation(fields: [categoryId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])
  mainImage Media?   @relation("ArticleMainImage", fields: [mainImageId], references: [id], onDelete: SetNull)

  translations     ArticleTranslation[]
  tags             ArticleTag[]
  media            ArticleMedia[]
  homepageSections HomepageSection[]
}

/**
 * =========================================================
 * ARTICLE TRANSLATION
 * =========================================================
 */

model ArticleTranslation {
  id        String   @id @default(cuid())
  articleId String
  language  Language

  title          String
  summary        String?   @db.Text
  content        String    @db.LongText

  seoTitle       String?
  seoDescription String?   @db.Text

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, language])
}

/**
 * =========================================================
 * TAG
 * =========================================================
 */

model Tag {
  id   String @id @default(cuid())
  slug String @unique
  name String @unique

  articles ArticleTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

/**
 * =========================================================
 * MEDIA
 * =========================================================
 */

model Media {
  id                String              @id @default(cuid())
  filename          String
  url               String              @db.Text
  type              MediaType

  mimeType          String?
  size              Int?
  width             Int?
  height            Int?
  altText           String?             @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mainArticles      Article[]           @relation("ArticleMainImage")
  articleMedia      ArticleMedia[]
  videoThumbnails   Video[]             @relation("VideoThumbnail")
  profileUsers      User[]              @relation("UserProfileImage")
  homepageSections  HomepageSection[]
}

/**
 * =========================================================
 * ARTICLE MEDIA
 * =========================================================
 */

model ArticleMedia {
  articleId String
  mediaId   String
  sortOrder Int    @default(0)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([articleId, mediaId])
}

/**
 * =========================================================
 * VIDEO
 * =========================================================
 */

model Video {
  id               String              @id @default(cuid())

  slug             String              @unique
  title            String
  description      String?             @db.Text

  language         Language            @default(EN)
  status           VideoStatus         @default(DRAFT)

  /**
   * Existing News Category relationship.
   * Kept unchanged for existing videos.
   */
  categoryId       String?
  videoCategoryId  String?

  thumbnailId      String?
  videoUrl         String              @db.Text

  duration         Int?
  views            Int                 @default(0)

  isFeatured       Boolean             @default(false)

  publishedAt      DateTime?
  scheduledAt      DateTime?

  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  /**
   * Existing News Category relation.
   */
  category         Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /**
   * New Video Category relation.
   */
  videoCategory    VideoCategory?      @relation(fields: [videoCategoryId], references: [id], onDelete: SetNull)

  /**
   * Existing thumbnail relation.
   */
  thumbnail        Media?              @relation("VideoThumbnail", fields: [thumbnailId], references: [id], onDelete: SetNull)

  homepageSections HomepageSection[]
}

/**
 * =========================================================
 * PAGE
 * =========================================================
 */

model Page {
  id   String @id @default(cuid())
  slug String @unique

  status PageStatus @default(DRAFT)

  translations PageTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PageTranslation {
  id       String   @id @default(cuid())
  pageId   String
  language Language

  title          String
  content        String   @db.LongText

  seoTitle       String?
  seoDescription String?  @db.Text

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, language])
}

/**
 * =========================================================
 * HOMEPAGE
 * =========================================================
 */

model HomepageSection {
  id String @id @default(cuid())

  type     HomepageSectionType
  title    String?
  position Int                 @default(0)

  isEnabled Boolean @default(true)

  articleId String?
  videoId   String?
  mediaId   String?

  article    Article?             @relation(fields: [articleId], references: [id], onDelete: SetNull)
  video      Video?               @relation(fields: [videoId], references: [id], onDelete: SetNull)
  media      Media?               @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
}

/* =========================================================
   MENU
========================================================= */

model MenuItem {
  id         String    @id @default(cuid())

  language   Language  @default(EN)

  label      String
  href       String    @db.Text

  position   Int       @default(0)
  isVisible  Boolean   @default(true)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

/* =========================================================
   LIVE TV
========================================================= */

model LiveStream {
  id           String          @id @default(cuid())

  channelName  String
  streamUrl    String          @db.Text
  streamType   LiveStreamType  @default(HLS)

  isLive       Boolean         @default(false)
  isEnabled    Boolean         @default(true)

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

/* =========================================================
   CONTACT MESSAGES
========================================================= */

model ContactMessage {
  id          String               @id @default(cuid())

  name        String
  email       String
  phone       String?
  subject     String
  message     String               @db.Text

  status      ContactMessageStatus @default(NEW)

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

/* =========================================================
   CMS ACTIVITY, NOTIFICATIONS AND PROFILE CHANGE APPROVAL
========================================================= */

model ActivityLog {
  id           String   @id @default(cuid())
  actorId      String
  action       String
  resourceType String
  resourceId   String?
  summary      String   @db.Text

  actor        User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([resourceType, resourceId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  title     String
  message   String   @db.Text
  href      String?
  isRead    Boolean  @default(false)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  readAt    DateTime?

  @@index([userId, isRead, createdAt])
}

model ProfileChangeRequest {
  id                  String                     @id @default(cuid())
  userId              String
  type                ProfileChangeRequestType
  requestedEmail      String?
  requestedPasswordHash String?                  @db.Text
  status              ProfileChangeRequestStatus @default(PENDING)
  reviewedById        String?
  reviewNote          String?                    @db.Text
  createdAt           DateTime                   @default(now())
  reviewedAt          DateTime?

  user                User                       @relation("ProfileChangeRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy          User?                      @relation("ProfileChangeRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
}

/* =========================================================
   SETTINGS
========================================================= */

model SiteSetting {
  id        String   @id @default(cuid())

  key       String   @unique
  value     String   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
