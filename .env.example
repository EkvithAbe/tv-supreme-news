# Local MySQL connection used by Prisma CLI and the Next.js server.
# Keep these values private. They stay on the server and are not sent to visitors.
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_DATABASE="supremenews"
MYSQL_USER="YOUR_MYSQL_USER"
MYSQL_PASSWORD="YOUR_MYSQL_PASSWORD"

# Gmail SMTP for the public Contact Us form. Use a Google App Password,
# never your normal Gmail password. Messages are sent directly and are not
# stored in MySQL.
GMAIL_USER="ekvith2003@gmail.com"
GMAIL_APP_PASSWORD="qbfr idvb djxs ojya"
CONTACT_RECIPIENT_EMAIL="ekvith2003@gmail.com"

# A long random secret used only by the hosting cron task. The task calls
# GET /api/cron/publish-scheduled once every minute with this bearer token.
CRON_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
